# HTTPS in front of PlateBox. Caddy asks Let's Encrypt for the certificate by itself: the name must already point at
# this server (a DNS "A" record) and ports 80 and 443 must be open.
{$PLATEBOX_PUBLIC_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy platebox:8080
}
